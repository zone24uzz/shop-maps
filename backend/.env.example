# Copy this file to `.env` and adjust the values. Never commit `.env`.

# --- Required -----------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/logistics_map
# Browser origin(s) allowed by CORS. Separate several origins with commas.
FRONTEND_URL=http://localhost:3000

# --- Optional (defaults shown) ------------------------------------------
# Requests allowed per client IP inside one rate-limit window.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000
# Number of reverse proxies in front of the API (0 = none). Needed so the
# rate limiter sees the real client IP when deployed behind a load balancer.
TRUST_PROXY=0
# How many times the API retries the initial MongoDB connection before exiting.
DB_CONNECT_RETRIES=5
